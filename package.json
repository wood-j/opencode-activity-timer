{
  "$schema": "https://opencode.ai/plugin.json",
  "name": "opencode-activity-timer",
  "version": "0.1.0",
  "description": "Show time since the last model output in the OpenCode TUI prompt bar, so you can spot stuck windows at a glance",
  "type": "module",
  "exports": {
    "./tui": "./activity-timer.tsx"
  },
  "files": [
    "activity-timer.tsx",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "opencode": ">=1.3.14"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/core": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "keywords": [
    "opencode",
    "plugin",
    "tui",
    "timer",
    "activity",
    "stuck",
    "timeout",
    "monitor"
  ],
  "license": "MIT"
}
